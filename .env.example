# Copy to .env.local and fill in from the Supabase dashboard (Project settings, API keys).
# Only the publishable key belongs in the app. Never put a secret or service role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
